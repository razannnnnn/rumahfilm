# Backend media server (server-side only)
STB_URL=https://api-rumahfilm.razn.my.id

# Public base URL used for internal server fetches
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# NextAuth
NEXTAUTH_SECRET=replace-with-random-string
NEXTAUTH_URL=http://localhost:3000

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-password

# TMDB metadata
TMDB_API_KEY=

# Film path on the Express backend
FILM_PATH=/mnt/harddisk/Film

# Google Sheets (optional, for film requests)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=